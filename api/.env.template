# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=corcel
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/corcel

# Flask & Security (Generate via: openssl rand -hex 32)
SECRET_KEY=generate_a_random_32_byte_hex_string_here
FLASK_APP=app/app
FLASK_DEBUG=false
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=https://corpsell.grpazinatto.com,http://localhost:5173,http://localhost

# Optional: Allowed domain name (e.g. corpsell.domain.com).
# If set, direct IP scans/bots are dropped (HTTP 444) and only this domain is served.
# If left blank, Nginx accepts all hostnames and direct IP access.
SERVER_NAME=

# LanguageTool (internal Docker network URL)
LANGUAGETOOL_URL=http://languagetool:8010

# Optional: OCR processing via Google Gemini
API_KEY=your_google_gemini_api_key_here
